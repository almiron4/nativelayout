diff -ruN a/android/core/src/test/kotlin/nativelayout/core/HeaderTest.kt b/android/core/src/test/kotlin/nativelayout/core/HeaderTest.kt
--- a/android/core/src/test/kotlin/nativelayout/core/HeaderTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/android/core/src/test/kotlin/nativelayout/core/HeaderTest.kt	2026-10-20 06:17:08.203617812 +0000
@@ -0,0 +1,89 @@
+/*
+ * Author: Adilson C. Rafael (adilson889)
+ * Date: 2026-10-20
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+
+package nativelayout.core
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Test
+
+/** The <header>: a bar fixed at the top of the screen, outside the scroll. */
+class HeaderTest {
+    private fun errorOf(html: String): String {
+        try {
+            LayoutEngine.build(html)
+        } catch (e: NativeLayoutError) {
+            return e.message
+        }
+        fail("expected an error")
+        return ""
+    }
+
+    @Test
+    fun headerComesFirstEvenWhenWrittenLater() {
+        val r = LayoutEngine.build(
+            """<div><p>Hi</p><header id="h"><p>Title</p></header><p>Bye</p></div>"""
+        )
+        val root = r.root as NativeBox
+        assertEquals(3, root.children.size)
+        val first = root.children.first() as NativeBox
+        assertTrue(first.header)
+        assertEquals("h", first.id)
+        assertFalse((root.children[1] as? NativeBox)?.header ?: false)
+    }
+
+    @Test
+    fun headerWithOnlyTextStaysABox() {
+        val h = LayoutEngine.build("""<div><header id="h">Title</header><p>Body</p></div>""").byId["h"]!!
+        assertTrue(h is NativeBox && h.header)
+    }
+
+    @Test
+    fun headerAndDialogTogether() {
+        val root = LayoutEngine.build(
+            """<div><dialog id="d"></dialog><p>Body</p><header id="h"></header></div>"""
+        ).root as NativeBox
+        assertTrue((root.children.first() as NativeBox).header)
+        assertTrue((root.children.last() as NativeBox).overlay)
+    }
+
+    @Test
+    fun headerMustBeAtTheFirstLevel() {
+        assertTrue(errorOf("<div><div><header></header></div></div>").contains("direct child of the root"))
+        assertTrue(errorOf("<header></header>").contains("direct child of the root"))
+    }
+
+    @Test
+    fun onlyOneHeaderIsAllowed() {
+        assertTrue(errorOf("<div><header></header><header></header></div>").contains("only one"))
+    }
+
+    @Test
+    fun headerKeyDoesNotDependOnTheNumberOfSiblings() {
+        val a = LayoutEngine.build("<div><header><p>T</p></header><p>A</p></div>").root as NativeBox
+        val b = LayoutEngine.build("<div><header><p>T</p></header><p>A</p><p>B</p></div>").root as NativeBox
+        assertEquals(a.children[0].key, b.children[0].key)
+    }
+
+    @Test
+    fun changingAHeaderIntoABoxIsAReplace() {
+        val before = LayoutEngine.build("""<div><header id="h"></header><p>A</p></div>""").root
+        val after = LayoutEngine.build("""<div><div id="h"></div><p>A</p></div>""").root
+        assertTrue(LayoutDiffer.diff(before, after).any { it is Change.Replace })
+    }
+
+    @Test
+    fun anUnchangedHeaderProducesNoChanges() {
+        val a = LayoutEngine.build("""<div><header><p>T</p></header><p>A</p></div>""").root
+        val b = LayoutEngine.build("""<div><header><p>T</p></header><p>A</p></div>""").root
+        assertTrue(LayoutDiffer.diff(a, b).isEmpty())
+    }
+}
diff -ruN a/android/core/src/test/kotlin/nativelayout/core/IconTest.kt b/android/core/src/test/kotlin/nativelayout/core/IconTest.kt
--- a/android/core/src/test/kotlin/nativelayout/core/IconTest.kt	1970-01-01 00:00:00.000000000 +0000
+++ b/android/core/src/test/kotlin/nativelayout/core/IconTest.kt	2026-10-20 06:17:08.203632410 +0000
@@ -0,0 +1,78 @@
+/*
+ * Author: Adilson C. Rafael (adilson889)
+ * Date: 2026-10-20
+ *
+ * This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at https://mozilla.org/MPL/2.0/.
+ */
+
+package nativelayout.core
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Assert.fail
+import org.junit.Test
+
+/** The built-in icons: `<img src="icon:name">`. */
+class IconTest {
+    private fun errorOf(html: String): String {
+        try {
+            LayoutEngine.build(html)
+        } catch (e: NativeLayoutError) {
+            return e.message
+        }
+        fail("expected an error")
+        return ""
+    }
+
+    @Test
+    fun nameOfReadsOnlyTheIconScheme() {
+        assertEquals("close", IconSet.nameOf("icon:close"))
+        assertEquals("close", IconSet.nameOf("icon: close "))
+        assertNull(IconSet.nameOf("photo.png"))
+        assertNull(IconSet.nameOf("data:image/png;base64,AAAA"))
+    }
+
+    @Test
+    fun anIconIsAnImage() {
+        val r = LayoutEngine.build("""<div><img id="i" src="icon:arrow-left" alt="Back"></div>""")
+        val img = r.byId["i"] as NativeImage
+        assertEquals("icon:arrow-left", img.source)
+        assertEquals("Back", img.description)
+    }
+
+    @Test
+    fun anUnknownIconIsAClearError() {
+        val msg = errorOf("""<div><img src="icon:nope"></div>""")
+        assertTrue(msg.contains("does not exist"))
+    }
+
+    @Test
+    fun everyIconHasShapesInsideTheGrid() {
+        assertTrue(IconSet.names.size >= 25)
+        for (name in IconSet.names) {
+            val shapes = IconSet.shapesOf(name)
+            assertNotNull(name, shapes)
+            assertTrue("$name has no shapes", shapes!!.isNotEmpty())
+            for (s in shapes) {
+                val values: List<Float> = when (s) {
+                    is IconShape.Line -> s.points.toList()
+                    is IconShape.Circle -> listOf(s.cx - s.r, s.cy - s.r, s.cx + s.r, s.cy + s.r)
+                    is IconShape.Dot -> listOf(s.cx, s.cy)
+                    is IconShape.Rect -> listOf(s.left, s.top, s.right, s.bottom)
+                }
+                for (v in values) assertTrue("$name: $v is outside the grid", v >= 0f && v <= IconSet.GRID)
+                if (s is IconShape.Line) assertTrue("$name: odd number of coordinates", s.points.size % 2 == 0)
+            }
+        }
+    }
+
+    @Test
+    fun iconColorFollowsTheTextColor() {
+        val r = LayoutEngine.build("""<div><img id="i" src="icon:check" style="color: #ff0000"></div>""")
+        assertEquals(0xFFFF0000.toInt(), r.byId["i"]!!.style.textColor)
+    }
+}
